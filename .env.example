# Sao chép file này thành `.env` rồi điền giá trị thật.
# `.env` đã được .gitignore bỏ qua — TUYỆT ĐỐI không commit nó.
# Khi deploy lên Vercel, khai các biến này trong Settings > Environment Variables
# thay vì dùng file .env.

# URL gốc của backend, PHẢI có hậu tố /api.
# Local: trỏ tới Spring Boot chạy ở máy. Production: URL của service trên Render.
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth Client ID (lấy trong Google Cloud Console > Credentials).
# Nhớ thêm domain production vào "Authorized JavaScript origins", nếu không
# nút đăng nhập Google sẽ báo lỗi origin mismatch.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Email admin, dùng để hiển thị thông tin liên hệ ở trang About.
VITE_ADMIN_EMAIL=your_admin_email_here
