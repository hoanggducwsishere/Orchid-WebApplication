# Sao chép file này thành `.env` rồi điền giá trị thật.
# `.env` đã được .gitignore bỏ qua — TUYỆT ĐỐI không commit nó.
# Spring Boot nạp file này qua `spring.config.import` trong application.properties.
# Khi deploy (Render, Docker, ...) thì không dùng file .env, hãy khai các biến dưới đây
# trực tiếp trong phần Environment Variables của nền tảng.

# --- CSDL PostgreSQL (mặc định khớp với backend/docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=orchid_db
DB_USER=orchid_user
DB_PASSWORD=orchid_password

# Khi deploy, dùng bộ biến này thay cho DB_* ở trên:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# --- Bảo mật ---
# BẮT BUỘC. Không có giá trị mặc định: thiếu biến này ứng dụng sẽ không khởi động được.
# Mỗi môi trường phải dùng một secret riêng, tối thiểu 32 ký tự.
# Sinh secret mới:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Tài khoản admin được seed tự động ---
ADMIN_EMAIL=admin@orchid.vn
ADMIN_PASSWORD=
SEED_DEMO_DATA=true
